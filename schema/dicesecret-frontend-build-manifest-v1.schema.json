{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dicesecret.com/schema/dicesecret-frontend-build-manifest-v1.schema.json",
  "title": "DiceSecret Frontend Build Manifest v1",
  "description": "Manifest for the exact static assets exported as a DiceSecret browser frontend build.",
  "type": "object",
  "required": [
    "$schema",
    "format",
    "source_commit",
    "api_origin",
    "assets"
  ],
  "properties": {
    "$schema": {
      "const": "https://dicesecret.com/schema/dicesecret-frontend-build-manifest-v1.schema.json"
    },
    "format": {
      "const": "dicesecret-frontend-build-manifest-v1"
    },
    "source_commit": {
      "type": "string",
      "description": "Full Git object ID of the private DiceVision source commit used for the export.",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "api_origin": {
      "type": "string",
      "format": "uri",
      "description": "Exact inference API origin embedded into the exported frontend."
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
